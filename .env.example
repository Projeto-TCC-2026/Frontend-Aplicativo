# Backend URL used by the mobile API adapter.
# Android emulator: http://10.0.2.2:8080
# iOS simulator: http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
# Function URL output `IngestionUrl` from the AWS `monitoramento` CloudFormation stack.
EXPO_PUBLIC_MONITORAMENTO_INGESTION_URL=
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
